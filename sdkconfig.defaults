# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# 48 号只给配对屏那 6 位数字用：用户要把它念到、抄进另一台设备，是这块屏上唯一
# 需要「隔着一米也看得清」的东西。Montserrat 不含中文，而配对码正好只有数字，
# 所以不必为它再生成一套中文字形。
CONFIG_LV_FONT_MONTSERRAT_48=y
# 汉字字体有两万多个字形，位图索引会超过默认的 20 位（1MB）上限——LVGL 为这个
# 场景提供了这个开关。不开的话编译报 -Woverflow，索引被截断成低 20 位，字体表
# 全乱（而且第一眼看上去像是字体生成错了）。
CONFIG_LV_FONT_FMT_TXT_LARGE=y

# 中文字形：用 tools/gen_badge_font.sh 自己生成的那份（main/badge_font_16.c）。
# LVGL 内置的 Source Han Sans 子集太小——它连「脑」「还」「连」都不含，而这块屏
# 要显示 tachi 下发的任意中文。内置那份因此关掉，省下的 Flash 给自己的字体。
# LVGL 内置 malloc 池大小(KB)。它是独立静态区、不与系统堆共享,配大了会白白占用 RAM。
# 本 demo UI 简单,24KB 足够;若自建复杂界面出现绘制卡死/看门狗,调大此值。
# LVGL 自己的堆。24KB 对"纯文字 + 小控件"够用（基线 demo 就是按这个配的），
# 但状态屏那块 120x120 的头像需要一块随面积走的绘制缓冲，一放进去就把它撑爆——
# 表现是**整屏变白**（分配失败，什么都画不出来），而设备本身还在正常收发协议，
# 所以看起来像"屏幕坏了"。48KB 留出余量；本板没有 PSRAM，但这个池是独立静态区，
# 从堆里扣 24KB 完全负担得起。
CONFIG_LV_MEM_SIZE_KILOBYTES=48

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- Bluetooth LE / NimBLE ---
# ESP32-C3 仅支持 BLE；示例只启用单连接 peripheral 所需的最小 host 配置。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
# 配对相关的三条，都是设计的一部分（探针实测过，见 tachi 设计文档附录 A.2）：
#   NVS_PERSIST：bond 要跨重启存活，否则「重连免配对」根本不成立
#   MAX_BONDS=1：badge 属于一台电脑，新配对顶掉旧的
#   HANDLE_REPEAT_PAIRING_DELETION：对方删了 bond 再来配时，本机那条陈旧的也要删掉
#     ——默认 n，正是「换电脑」时最经典的死锁
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_HANDLE_REPEAT_PAIRING_DELETION=y
# MSYS 的块要装得下**一个 ATT 包**：NimBLE 的内部上限是 BLE_ATT_ATTR_MAX_LEN=512，
# 而默认 256 的块（去掉 mbuf 头只剩 ~220）装不下一条 253 字节的 notify —— 每条都要跨
# 两块，池的消耗翻倍，连发几片就再也拿不到缓冲（实测：第 4 片起整片失败，主机只看到
# 3 KB，日志是「池里拿不到 mbuf，剩 24」）。640 让一条 253 字节的消息单块装下。
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=640
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
